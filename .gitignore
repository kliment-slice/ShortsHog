# raw footage, one folder per event
content/

# generated output (dir/* so the template's .gitkeep files survive)
renders/*
models/*
!events/_template/*/.gitkeep

# media anywhere else, any extension case
*.[wW][aA][vV]
*.[mM][pP]4
*.[mM][oO][vV]
*.[mM]4[aA]
*.[mM][xX][fF]
*.[aA][iI][fF][fF]

# local env
.venv/
__pycache__/
.DS_Store

# frame grabs for crops
events/*/stills/

# exports reference absolute media paths; synthetic test event is regenerated
events/*/exports/
events/synth-test/
